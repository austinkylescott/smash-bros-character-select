{
  /* Convex's own settings for its functions, which `convex dev` and `convex deploy` type-check. */
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    // For `process.env` in auth.config.ts, which Convex fills from the deployment's settings.
    "types": ["node"]
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
